# Recruiter Agency - Environment Configuration
# Copy this to .env and fill in your values

# OpenRouter API Key (Preferred)
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Google Gemini API Key (Fallback or Direct)
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Default models
# When using OpenRouter, these are mapped to their equivalents
LLM_MODEL_DEFAULT=gemini-3.1-flash-lite
LLM_MODEL_EVALUATION=gemini-3.1-flash
LLM_MODEL_TAILORING=gemini-3.1-flash

# Database path (default: agentdb/applications.db)
DB_PATH=agentdb/applications.db

# LangGraph checkpoint database path
CHECKPOINT_DB_PATH=agentdb/checkpoints.db

# Memory database path
MEMORY_DB_PATH=agentdb/memory.db

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
